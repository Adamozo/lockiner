# LockIner - Environment Variables Template
# Skopiuj ten plik jako `.env` i wypełnij swoimi wartościami

# === Security ===
# Encryption key for API keys storage (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-generated-encryption-key-here

# === AI API Keys ===
# Anthropic Claude API (do OCR paragonów)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Alternatywnie (jeśli używasz innych modeli):
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...

# === Backend Configuration ===
# Environment (development/production)
ENVIRONMENT=development

# FastAPI
RELOAD=true  # Hot reload w development (false w production)

# Database (PostgreSQL)
POSTGRES_USER=scrooge
POSTGRES_PASSWORD=scrooge_secret_change_me
POSTGRES_DB=scrooge_db
DATABASE_URL=postgresql+asyncpg://scrooge:scrooge_secret_change_me@postgres:5432/scrooge_db

# Authentication (JWT)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Uploads
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:3000

# === Frontend Configuration ===
# Nuxt
NODE_ENV=development
API_BASE_URL=http://backend:8000

# === Optional ===
# Logging
LOG_LEVEL=info

# Rate Limiting (AI API calls per minute)
AI_API_RATE_LIMIT=10
