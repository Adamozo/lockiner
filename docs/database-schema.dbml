// ============================================================
// AUTH & USERS
// ============================================================

Table users {
  id integer [pk, increment]
  email_hash varchar [unique, not null]
  password_hash varchar [not null]
  nick varchar(20) [not null, note: 'pseudonim użytkownika, min 8 max 20 znaków']
  role varchar(20) [default: 'user']
  is_active boolean [default: true]
  totp_secret_encrypted text
  totp_enabled boolean [default: false]
  recovery_codes_hash text //TODO zastanowić się co z tym
  language varchar [default: 'en']
  created_at varchar
  updated_at varchar
}

Table vouchers {
  id integer [pk, increment]
  code varchar [unique, not null] //TODO tutaj trzbea sie zastanowaic jak to zrobic bo trzeba mieć jakoś kody któr można rozdać ale do samego użycia kodu wystarczy hash. Możlwie że proces generowani tych kodów trzeba będzie dprawcować tak żeby można było trzymać sam hash kodu oraz dodak kolument wersja żeby wiedzyeć jaka wersja funkcji hashujacej została tutaj użyta
  status varchar(20) [default: 'available']
  used_by_user_id integer [ref: > users.id]
  used_at varchar
  created_at varchar
}

Table user_api_keys {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  provider varchar(50) [not null]
  encrypted_key text [not null]
  is_active boolean [default: false]
  created_at varchar
  updated_at varchar
}

// ============================================================
// OAUTH
// ============================================================

Table oauth_clients { //TODO trzba dodać do rzeczy do przekminia jak chce roziwązać dodawanie integracji oauth przez UI
  id integer [pk, increment] 
  client_id varchar(100) [unique, not null]
  client_name varchar(100) [not null]
  redirect_uris text [not null]
  is_active boolean
  created_at varchar
}

Table oauth_access_tokens {
  id integer [pk, increment]
  access_token varchar(256) [unique, not null] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  refresh_token varchar(256) [unique] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  client_id integer [not null, ref: > oauth_clients.id]
  user_id integer [not null, ref: > users.id]
  expires_at varchar [not null]
  refresh_token_expires_at varchar
  revoked boolean
  created_at varchar
}

Table oauth_authorization_codes {
  id integer [pk, increment]
  code varchar(128) [unique, not null] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  client_id integer [not null, ref: > oauth_clients.id]
  user_id integer [not null, ref: > users.id]
  code_challenge varchar(128) [not null] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  code_challenge_method varchar(10) [not null] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  redirect_uri varchar(500) [not null]
  expires_at varchar [not null]
  used boolean
  created_at varchar
}

Table oauth_device_codes {
  id integer [pk, increment]
  device_code varchar(256) [unique, not null] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  user_code varchar(20) [unique, not null] //TODO czy to może tak być czy ptorzebny hash albo szyfrownie
  client_id integer [not null, ref: > oauth_clients.id]
  user_id integer [ref: > users.id]
  status varchar(20) [default: 'pending']
  expires_at varchar [not null]
  created_at varchar
}

// ============================================================
// HOUSEHOLDS
// ============================================================

Table households {
  id integer [pk, increment]
  uid varchar [unique, not null]
  name varchar [not null] //TODO do sprawdzenia ale tutaj chyba jakieś client side entryption
  description text //TODO do sprawdzenia ale tutaj chyba jakieś client side entryption
  icon varchar
  created_at varchar
  updated_at varchar
}

Table household_members {
  id integer [pk, increment]
  household_id integer [not null, ref: > households.id]
  user_id integer [not null, ref: > users.id]
  role varchar [default: 'member']
  status varchar [default: 'active']
  joined_at varchar
}

Table household_invitations {
  id integer [pk, increment]
  household_id integer [not null, ref: > households.id]
  token varchar [unique, not null]
  created_by integer [not null, ref: > users.id]
  expires_at varchar
  max_uses integer
  uses_count integer [default: 0]
  is_active boolean [default: true]
  created_at varchar
}

