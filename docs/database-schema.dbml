  id integer [pk, increment]
  household_id integer [unique, not null, ref: > households.id]
  configured_by_user_id integer [ref: > users.id]
  encrypted_password text
  auto_backup_enabled boolean [default: false]
  frequency varchar(20) [default: 'weekly']
  hour integer [default: 3]
  minute integer [default: 0]
  day_of_week integer
  day_of_month integer
  google_drive_connected boolean [default: false]
  google_drive_folder_id varchar
  last_backup_at varchar
  last_backup_filename varchar
  last_backup_size_bytes integer
  created_at varchar [not null]
  updated_at varchar
}
