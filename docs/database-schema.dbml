}

Table receipt_images {
  id integer [pk, increment]
  receipt_id integer [not null, ref: > receipts.id]
  image_path varchar [not null] //TODO ten sam porblem co we wcześniejszych todo dtyczący tego kto może podglądać zawratość zdjecia
  sort_order integer [default: 0]
  created_at varchar
}

Table user_receipts {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  receipt_id integer [not null, ref: > receipts.id]
  created_at varchar
}

Table household_receipts {
  id integer [pk, increment]
  household_id integer [not null, ref: > households.id]
  receipt_id integer [not null, ref: > receipts.id]
  added_by_user_id integer [ref: > users.id]
  created_at varchar
}

// ============================================================
// FOOD — CATALOG
// ============================================================

Table food_categories {
  id integer [pk, increment]
  name varchar [unique, not null]
  icon varchar
  color varchar
  default_expiry_days integer
  storage_tips text
}

Table food_products {
  id integer [pk, increment]
  name varchar [not null]
  name_normalized varchar [not null]
  barcode varchar
  barcode_type varchar
  food_category_id integer [ref: > food_categories.id]
  calories float
  protein float
  carbohydrates float
  fat float
  fiber float
  sugar float
  sodium float
  default_unit varchar [default: 'szt']
  is_verified boolean [default: false]
  created_by_user_id integer [ref: > users.id]
  created_at varchar
  updated_at varchar
}

Table food_product_aliases {
  id integer [pk, increment]
  product_id integer [not null, ref: > food_products.id]
  alias varchar [not null]
  alias_normalized varchar [not null]
  source varchar [default: 'manual']
  created_by_user_id integer [ref: > users.id]
  created_at varchar
}

// ============================================================
// FOOD — INVENTORY & IMPORT
// ============================================================

Table food_pending_imports {
  id integer [pk, increment]
  receipt_id integer [not null, ref: > receipts.id]
  user_id integer [not null, ref: > users.id]
  household_id integer [ref: > households.id]
  status varchar [default: 'pending']
  created_at varchar
  processed_at varchar
}

Table food_pending_import_items {
  id integer [pk, increment]
  pending_import_id integer [not null, ref: > food_pending_imports.id]
  original_name varchar [not null]
  original_name_normalized varchar [not null]
  quantity float [default: 1]
  unit_price float
  total_price float
  matched_product_id integer [ref: > food_products.id]
  match_method varchar
  match_confidence float
  ai_suggested_name varchar
  ai_suggested_category_id integer [ref: > food_categories.id]
  ai_suggested_expiry_days integer
  suggested_expiry_date varchar
  status varchar [default: 'pending']
  final_product_id integer [ref: > food_products.id]
  final_expiry_date varchar
  final_quantity float
  final_unit varchar
  created_new_product boolean [default: false]
  processed_at varchar
}

Table food_inventory {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  household_id integer [ref: > households.id]
  product_id integer [not null, ref: > food_products.id]
  quantity float [default: 1]
  unit varchar [default: 'szt']
  purchase_date varchar
  expiry_date varchar
  opened_date varchar
  receipt_id integer [ref: > receipts.id]
  pending_import_item_id integer [ref: > food_pending_import_items.id]
  added_manually boolean [default: false]
  status varchar [default: 'available']
  location varchar [default: 'pantry']
  notes text
  created_at varchar
  updated_at varchar
}

Table food_expiry_reminders {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  inventory_item_id integer [not null, ref: > food_inventory.id]
  remind_at varchar [not null]
  days_before_expiry integer [not null]
  status varchar [default: 'pending']
  sent_at varchar
  created_at varchar
}

Table food_reminder_settings {
  id integer [pk, increment]
  user_id integer [unique, not null, ref: > users.id]
  enabled boolean [default: true]
  default_days_before integer [default: 3]
  dairy_days_before integer [default: 2]
  meat_days_before integer [default: 1]
  vegetables_days_before integer [default: 2]
  fruits_days_before integer [default: 2]
  bread_days_before integer [default: 1]
  frozen_days_before integer [default: 7]
  created_at varchar
  updated_at varchar
}

// ============================================================
// FOOD — CONSUMPTION & GOALS
// ============================================================

Table food_consumption_log {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  product_id integer [ref: > food_products.id]
  inventory_item_id integer [ref: > food_inventory.id]
  quantity float [default: 1]
  unit varchar [default: 'szt']
  calories float
  protein float
  carbohydrates float
  fat float
  consumed_at varchar [not null]
  meal_type varchar
  notes text
  off_product_code varchar
  product_name varchar
  created_at varchar
}

Table food_daily_goals {
  id integer [pk, increment]
  user_id integer [unique, not null, ref: > users.id]
  calories float [default: 2000]
  protein float
  carbohydrates float
  fat float
  updated_at varchar
}

// ============================================================
// FOOD — RECIPES
// ============================================================

Table food_recipes {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  name varchar [not null]
  description text
  prep_time_minutes integer
  servings integer
