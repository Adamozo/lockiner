  updated_at varchar
}

Table body_measurement_entries {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  date varchar [not null]
  bicep_cm float
  waist_cm float
  thigh_cm float
  calf_cm float
  chest_cm float
  notes text
  created_at varchar
}

Table meditation_sessions {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  date varchar [not null]
  started_at varchar [not null]
