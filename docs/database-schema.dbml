Table transactions {
  id integer [pk, increment]
  date varchar [not null]
  amount float [not null]
  description text //TODO tutaj chyba client side entryption
  category varchar [default: 'Inne'] //TODO tutaj chyba client side entryption
  payment_method varchar
  receipt_id integer [ref: > receipts.id]
  notes text //TODO tutaj chyba client side entryption
  created_at varchar
}

Table user_transactions {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  transaction_id integer [not null, ref: > transactions.id]
  created_at varchar
}

Table household_transactions {
  id integer [pk, increment]
  household_id integer [not null, ref: > households.id]
  transaction_id integer [not null, ref: > transactions.id]
  added_by_user_id integer [ref: > users.id]
  created_at varchar
}

Table monthly_imports { //TODO co sie dzieje z zaimportowanymi plikami? czy są gdzies dalej trzymane? jak tak czy są w zasyfrowanym zipie??? nie powinny być trzymane tak po porstu na serwerze żeby zajmować więcej miejsca niż trzeba i żeby każdy mógł je sobie podejrzeć. Może nei warto ich trzymać wcale tylko zapisywać iforamcje jak nazywał sie plik który został wykrozystany do importu?
  id integer [pk, increment]
  month varchar [not null]
  filename varchar
  transactions_count integer
  imported_at varchar
}

// ============================================================
