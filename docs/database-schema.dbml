// RECEIPTS
// ============================================================

Table receipts {
  id integer [pk, increment]
  image_path varchar [not null] //TODO co się dzieje ze zdjęciami pargaonów po imporcie? w jaki sposób są trzymane? czy ktoś może je po prostu podejrzeć? może warto dodać opcje że zdjećia paragonów będą trzymane zaszyfrowane ale tedy nie można podejrzeć zdjecia paragonu an forncie i przentowany jest po prosu placeholder?
  scan_date varchar [not null]
